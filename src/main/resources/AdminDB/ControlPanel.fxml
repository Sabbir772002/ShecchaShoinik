<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="596" prefWidth="776.0" style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%,#000000  0%, #e74c3c  100%);" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="AdminDB.ControlPanelController">
    <children>
        <Button layoutX="84.0" layoutY="200.0" mnemonicParsing="false" onAction="#viewuser" prefHeight="33.0" prefWidth="131.0" style="-fx-background-color: grey;" text="View All User" />
        <Button layoutX="84.0" layoutY="263.0" mnemonicParsing="false" onAction="#viewteam" prefHeight="34.0" prefWidth="131.0" style="-fx-background-color: grey;" text="View All Team" />
        <Button layoutX="84.0" layoutY="317.0" mnemonicParsing="false" onAction="#viewpost" prefHeight="34.0" prefWidth="131.0" style="-fx-background-color: grey;" text="View All Post" />
        <Label layoutX="14.0" layoutY="14.0" prefHeight="26.0" prefWidth="463.0" style="-fx-border-color: white; -fx-padding: 4;" text="Control Your Area User, Team and Post" textFill="WHITE">
            <font>
                <Font name="Bell MT Bold" size="21.0" />
            </font>
        </Label>
        <TableView fx:id="alluser" layoutX="316.0" layoutY="74.0" onMouseClicked="#tableclickuser" prefHeight="517.0" prefWidth="448.0" visible="false">
            <columns>
                <TableColumn fx:id="Name" prefWidth="176.0" text="Name" />
                <TableColumn fx:id="Username" minWidth="8.0" prefWidth="126.4000244140625" text="Username" />
                <TableColumn fx:id="District" minWidth="8.0" prefWidth="144.79998779296875" text="District" />
            </columns>
        </TableView>
        <TableView fx:id="team" layoutX="246.0" layoutY="91.0" onMouseClicked="#tableclickteam" prefHeight="486.0" prefWidth="518.0" visible="false">
            <columns>
                <TableColumn fx:id="Teamname" prefWidth="132.79998779296875" text="Name" />
                <TableColumn fx:id="Teamuser" minWidth="8.0" prefWidth="122.4000244140625" text="Username" />
                <TableColumn fx:id="TeamDistrict" minWidth="8.0" prefWidth="147.199951171875" text="District" />
                <TableColumn fx:id="TeamType" minWidth="8.0" prefWidth="147.199951171875" text="Type" />
            </columns>
        </TableView>
        <TableView fx:id="post" layoutX="272.0" layoutY="81.0" onMouseClicked="#tablcclickpost" prefHeight="506.0" prefWidth="492.0">
            <columns>
            <TableColumn fx:id="ID" minWidth="0.0" prefWidth="0.0" text="ID" />
                <TableColumn fx:id="title" prefWidth="204.79998779296875" text="Title" />
                <TableColumn fx:id="PostDistrict" minWidth="8.0" prefWidth="159.20001220703125" text="District" />
                <TableColumn fx:id="PostType" minWidth="0.0" prefWidth="127.20001220703125" text="Type" />
            </columns>
        </TableView>
    </children>

</AnchorPane>
